# 行尾统一为 LF，避免 Windows 用户提交 CRLF 差异
* text=auto eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.woff binary
*.woff2 binary

# 7.7 MB 的 index.html 不做 diff 高亮（GitHub 会报太大）
index.html diff=none
